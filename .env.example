# FacultyForge AI - Backend Environment Configuration
PROJECT_NAME="FacultyForge AI"
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-secure-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Persistent SQLite database)
DATABASE_URL="sqlite:///./backend/facultyforge.db"

# CORS Origins (Comma-separated or JSON list for deployed domain)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Optional AI Provider Keys (System works autonomously without external keys)
# GEMINI_API_KEY="your-gemini-api-key"
# OPENAI_API_KEY="your-openai-api-key"
