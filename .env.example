# ==============================================================================
# FacultyForge AI - Supabase & Next.js Environment Variables
# ==============================================================================

# Supabase Public API URL & Anon Key (Accessible on both server & client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (Server-side ONLY - bypasses RLS for administrative jobs)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Application Base URL (for email auth redirects and QR code verification links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Generative LLM Provider (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
ENABLE_LLM=false
