# FacultyForge AI - Backend Environment Configuration
PROJECT_NAME="FacultyForge AI"
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-secure-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_URL="http://localhost:5173"

# Canonical SQLite Database Configuration
# Leave empty for local development (resolves canonically to backend/facultyforge.db)
# For cloud deployment with persistent disk, set absolute path (e.g. /data/facultyforge.db)
SQLITE_DB_PATH=

# AI Provider Configuration (System works autonomously with smart deterministic algorithms if key is empty)
GEMINI_API_KEY=
AI_PROVIDER="deterministic"
AI_MODEL="gemini-1.5-flash"
