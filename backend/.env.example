PROJECT_NAME="FacultyForge AI"
API_V1_STR="/api/v1"
FRONTEND_URL=http://localhost:5173
SECRET_KEY=facultyforge-secret-key-change-in-production

# Canonical SQLite Database Configuration
# Leave empty for local development (defaults to backend/facultyforge.db)
# For cloud deployment with persistent disk, specify absolute path (e.g. /data/facultyforge.db)
SQLITE_DB_PATH=

# AI Provider Configuration
# Set to 'deterministic' (offline smart algorithms) or 'llm' (when external GEMINI_API_KEY provided)
AI_PROVIDER="deterministic"
GEMINI_API_KEY=
AI_MODEL="gemini-1.5-flash"
